# Salin menjadi .env lalu sesuaikan. Berkas .env tidak ikut di-commit.

# Password database internal (tidak dibuka ke luar jaringan Docker). Wajib diisi.
POSTGRES_PASSWORD=ganti-dengan-password-acak

# Level log untuk api dan worker: DEBUG, INFO, WARNING, ERROR
RAJDOLL_LOG_LEVEL=INFO

# LLM lokal (LM Studio di Windows). Dipakai mulai fase F7.
RAJDOLL_LLM_BASE_URL=http://host.docker.internal:1234/v1
RAJDOLL_LLM_MODEL=qwen3-4b
