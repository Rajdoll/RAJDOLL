# Salin menjadi .env lalu sesuaikan. Berkas .env tidak ikut di-commit.

# Rahasia internal. Wajib diisi, masing-masing dengan nilai acak yang berbeda, misalnya hasil:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Password database internal (tidak dibuka ke luar jaringan Docker).
POSTGRES_PASSWORD=ganti-dengan-password-acak
# Password peran database rajdoll_tools yang dipakai egress proxy (hak akses terbatas).
TOOLS_DB_PASSWORD=ganti-dengan-password-acak-lain
# Token bersama antara api/worker dan container tools (runner dan egress proxy).
TOOLS_TOKEN=ganti-dengan-token-acak

# Level log untuk api dan worker: DEBUG, INFO, WARNING, ERROR
RAJDOLL_LOG_LEVEL=INFO

# LLM lokal (LM Studio di Windows). Dipakai mulai fase F7.
RAJDOLL_LLM_BASE_URL=http://host.docker.internal:1234/v1
RAJDOLL_LLM_MODEL=qwen3-4b
